{
  "description": "Signing test vectors for the delsign API. The keys are test keys, published here; never use them for anything else. Each vector gives a request body and, for each signature in it, the exact message signed. A client's signing code should reproduce every signature exactly. Send vectors are signed with key1 and have a fixed expiry, so a live server rejects them (expiry must be within the next 5 minutes); they're for testing signing code. Generated by apidocs_test.go; don't edit by hand.",
  "algorithm": "RSASSA-PKCS1-v1_5 with SHA-256 over the UTF-8 message. Keys and signatures are hex: public keys are SPKI (PKIX) DER, private keys PKCS #8 DER.",
  "keys": {
    "key1": {
      "publicKeySpkiHex": "",
      "privateKeyPkcs8Hex": ""
    },
    "key2": {
      "publicKeySpkiHex": "",
      "privateKeyPkcs8Hex": ""
    }
  },
  "vectors": [
    {
      "name": "register",
      "description": "First registration of key1. sig4reg is key1's signature over the email.",
      "request": "POST /api/v1/keyreg",
      "signatures": [
        {
          "field": "sig4reg",
          "key": "key1",
          "message": "a@example.com",
          "signature": ""
        }
      ],
      "body": {
        "email": "a@example.com",
        "pubkey": "",
        "sig4reg": ""
      }
    },
    {
      "name": "rotate",
      "description": "Replacing key1 with key2. sig4reg is the new key's (key2) signature over the email; sig4rotate is the current key's (key1) signature over the email followed by key2's public key hex.",
      "request": "POST /api/v1/keyreg",
      "signatures": [
        {
          "field": "sig4reg",
          "key": "key2",
          "message": "a@example.com",
          "signature": ""
        },
        {
          "field": "sig4rotate",
          "key": "key1",
          "message": "a@example.",
          "signature": ""
        }
      ],
      "body": {
        "email": "a@example.com",
        "pubkey": "",
        "sig4reg": "",
        "sig4rotate": ""
      }
    },
    {
      "name": "send",
      "description": "Send 0.001 ETH. The message is source + dest + amount + requestId + expiry.",
      "request": "POST /api/v1/wallets/send",
      "signatures": [
        {
          "field": "sig",
          "key": "key1",
          "message": "0x17155B71982feD535Fd6aeB084C9330e7d5C290f0x812B8C4D02f5901C7Dcdac0526bA915B61dAc33c10000000000000006f1c2a7e-0b9d-4c55-9a43-2f1e8d7c6b5a1800000060",
          "signature": ""
        }
      ],
      "body": {
        "source": "0x17155B71982feD535Fd6aeB084C9330e7d5C290f",
        "dest": "0x812B8C4D02f5901C7Dcdac0526bA915B61dAc33c",
        "amount": "1000000000000000",
        "requestId": "6f1c2a7e-0b9d-4c55-9a43-2f1e8d7c6b5a",
        "expiry": 1800000060,
        "sig": ""
      }
    },
    {
      "name": "send, lowercase addresses",
      "description": "The same send with the addresses in lowercase. The server accepts either case, but the signature covers the addresses exactly as sent, so the signature differs.",
      "request": "POST /api/v1/wallets/send",
      "signatures": [
        {
          "field": "sig",
          "key": "key1",
          "message": "0x17155b71982fed535fd6aeb084c9330e7d5c290f0x812b8c4d02f5901c7dcdac0526ba915b61dac33c10000000000000006f1c2a7e-0b9d-4c55-9a43-2f1e8d7c6b5a1800000060",
          "signature": ""
        }
      ],
      "body": {
        "source": "0x17155b71982fed535fd6aeb084c9330e7d5c290f",
        "dest": "0x812b8c4d02f5901c7dcdac0526ba915b61dac33c",
        "amount": "1000000000000000",
        "requestId": "6f1c2a7e-0b9d-4c55-9a43-2f1e8d7c6b5a",
        "expiry": 1800000060,
        "sig": ""
      }
    },
    {
      "name": "send, large amount",
      "description": "An amount above 2^53, which a JavaScript number can't hold exactly. Keep amounts as strings or BigInt; the message has the decimal digits as sent.",
      "request": "POST /api/v1/wallets/send",
      "signatures": [
        {
